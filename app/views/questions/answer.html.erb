 <div class="container mt-4">
  <h1>Stupid Coaching</h1>
   <div class="mb-4">
    <div class="card p-3" style="border-left: 5px solid lightgrey;">
      <p><%= @question %></p>
      <p><i>-You</i></p>
    </div>
  </div>

  <div class="mb-4">
    <div class="card p-3" style="border-left: 5px solid lightgrey; background-color: #fff9c4;">
      <p><strong><%= @answer %></strong></p>
      <p><i>-Your Coach</i></p>
    </div>
  </div>

  <%# <a href="/ask">Ask another question</a> %>
  <%= link_to "Ask another question", ask_path, class: "btn btn-primary mt-4" %>
</div>
